# Rust (application lockfile Cargo.lock stays tracked)
/target/
**/*.rs.bk
rustc-ice-*.txt

# Node.js, React, TypeScript and Vite (package-lock.json stays tracked)
**/node_modules/
/frontend/dist/
**/*.tsbuildinfo
**/.vite/
**/.cache/
/frontend/vite.config.js
/frontend/vite.config.d.ts

# Test reports and coverage
**/coverage/
**/playwright-report/
**/test-results/
**/blob-report/

# Local configuration, Docker data and integration-test artifacts
/data/
**/.env
**/.env.*
!**/.env.example
.cm-image-*/

# Logs and editor / operating-system artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.swp
*.swo
.idea/
.DS_Store
Thumbs.db
